{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/refs/heads/main/schemas/devContainer.schema.json",
  "name": "Example devcontainer for lua",
  "runArgs": [
    "--name",
    "example-devcontainer-for-lua-${devcontainerId}"
  ],
  "build": {
    "dockerfile": "Dockerfile",
    "cacheFrom": "type=registry,ref=ghcr.io/dhhyi/dcc-devcontainer-lua-cache"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "files.exclude": {
          ".devcontainer": true,
          ".update_devcontainer.sh": true,
          ".vscode": true
        }
      },
      "extensions": [
        "sumneko.lua",
        "bubuabu.busted-test-explorer"
      ]
    }
  },
  "containerEnv": {
    "DCC_SELFTEST": "bHVhIC12Cmx1YXJvY2tzIC0tdmVyc2lvbgpsdWEgLWUgJ3ByaW50KCJIZWxsbyBXb3JsZCEiKScK"
  }
}
